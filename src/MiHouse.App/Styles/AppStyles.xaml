<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:appearance="using:MiHouse.App.Appearance"
  xmlns:views="using:MiHouse.App.Views">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <LinearGradientBrush x:Key="RoomEdgeBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00272727" /><GradientStop Color="#FF272727" Offset="1" /></LinearGradientBrush>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <LinearGradientBrush x:Key="RoomEdgeBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FAFAFA" /><GradientStop Color="#FFFAFAFA" Offset="1" /></LinearGradientBrush>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="RoomEdgeBrush" Color="Transparent" /></ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <views:BooleanVisibilityConverter x:Key="BooleanVisibilityConverter" />
  <views:HasTextConverter x:Key="HasTextConverter" />
  <views:QrImageConverter x:Key="QrImageConverter" />
  <views:OnlineOpacityConverter x:Key="OnlineOpacityConverter" />
  <views:RoomSelectionBrushConverter x:Key="RoomSelectionBrushConverter" />
  <views:RoomPillBrushConverter x:Key="RoomPillBrushConverter" />
  <views:DeviceIconConverter x:Key="DeviceIconConverter" />
  <!--
    Mutable accent brushes. AppearanceService recolors these in place (Color/Opacity) so every
    StaticResource holder repaints immediately; do not switch these to ThemeResource.
  -->
  <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4" />
  <!-- The color the user picked, before the light/dark accent ramp is applied. -->
  <SolidColorBrush x:Key="AccentBaseBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#0078D4" Opacity="0.12" />
  <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="DeviceIconBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="DeviceIconBackdropBrush" Color="#0078D4" Opacity="0.12" />
  <!--
    System accent keys overridden so built-in controls (NavigationView, ToggleSwitch, ProgressRing,
    accent buttons) follow the app accent. The brushes are mutated in place; the color keys below
    are replaced on change.
  -->
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#0078D4" Opacity="0.9" />
  <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0078D4" Opacity="0.8" />
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFFFFF" Opacity="0.7" />
  <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#429CE3" />
  <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#76B9ED" />
  <!--
    Aliases the WinUI theme dictionary resolves with StaticResource: they capture the framework
    brush instance once, so a later accent change never reaches the controls that use them
    (the NavigationView selection bar, the ListView selection indicator, the progress ring, the
    ColorPicker sliders). Declaring the aliases here hands the instance to the app, and
    AppearanceService repaints them in place whenever the accent or the theme changes.
  -->
  <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#0078D4" />
  <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="#0078D4" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#0078D4" Opacity="0.9" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#0078D4" Opacity="0.8" />
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="#0078D4" />
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#0078D4" Opacity="0.9" />
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#0078D4" Opacity="0.8" />
  <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#0078D4" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#0078D4" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
  <Color x:Key="SystemAccentColor">#FF0078D4</Color>
  <Color x:Key="SystemAccentColorLight1">#FF429CE3</Color>
  <Color x:Key="SystemAccentColorLight2">#FF76B9ED</Color>
  <Color x:Key="SystemAccentColorLight3">#FFA6D4F5</Color>
  <Color x:Key="SystemAccentColorDark1">#FF005A9E</Color>
  <Color x:Key="SystemAccentColorDark2">#FF004578</Color>
  <Color x:Key="SystemAccentColorDark3">#FF00263B</Color>
  <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!--
    Shared icon area. Device tiles, the device detail header, the category cards and the scene
    cards all show their glyph in the same 40x40 well with the same 36x36 icon box, so the four
    places are visually identical and only one set of sizes is defined.
  -->
  <Style x:Key="DeviceIconAreaStyle" TargetType="Grid">
    <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" />
    <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!--
    Device and scene icons. The MDI glyphs are drawn on a 24x24 grid, but PathIcon does not
    scale its geometry: it renders the path at its natural size and clips it to the control
    bounds, so a small PathIcon cuts the right and bottom of the artwork off. Giving the
    PathIcon the full 24x24 grid and letting a Viewbox do the scaling keeps every glyph
    complete and keeps all glyphs on the same scale. The Viewbox is the icon area itself,
    so the artwork sits directly on the card without a backdrop plate.
  -->
  <Style x:Key="DeviceIconViewboxStyle" TargetType="Viewbox">
    <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="DeviceIconPathStyle" TargetType="PathIcon">
    <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" />
  </Style>
  <Thickness x:Key="DashboardCardPadding">12</Thickness>
  <x:Double x:Key="DashboardCardMinHeight">100</x:Double>
  <ItemsPanelTemplate x:Key="DashboardCardsPanel"><views:ResponsiveGridPanel MinimumItemWidth="180" MaximumColumns="2" /></ItemsPanelTemplate>
  <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style x:Key="PropertySurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="SectionSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style x:Key="FlatHitButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
        Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SectionTileButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="0" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="{StaticResource DashboardCardMinHeight}" />
  </Style>
  <Style x:Key="SceneCardSurfaceStyle" TargetType="Border" BasedOn="{StaticResource SectionSurfaceStyle}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="{StaticResource DashboardCardMinHeight}" />
  </Style>
  <DataTemplate x:Key="SceneCardTemplate">
    <Border Style="{StaticResource SceneCardSurfaceStyle}">
      <Grid>
       <views:FeedbackHalo BurstToken="{Binding ExecutionVersion}" />
       <Grid ColumnSpacing="12" VerticalAlignment="Center" Padding="{StaticResource DashboardCardPadding}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Style="{StaticResource DeviceIconAreaStyle}">
          <FontIcon Glyph="&#xE945;" FontSize="32" Foreground="{StaticResource DeviceIconBrush}"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibilityConverter}, ConverterParameter=Inverse}" />
          <ProgressRing Width="16" Height="16" MinWidth="16" MinHeight="16" appearance:MotionGate.Active="{Binding IsBusy}"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibilityConverter}}" AutomationProperties.Name="正在执行场景" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
          <TextBlock Text="已停用" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="{Binding IsDisabled, Converter={StaticResource BooleanVisibilityConverter}}" />
        </StackPanel>
        <Button Grid.Column="2" Content="执行" Command="{Binding RunCommand}"
          VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.Name="{Binding AccessibleName}" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Error}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
          Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{Binding Error, Converter={StaticResource HasTextConverter}}" AutomationProperties.LiveSetting="Polite" />
       </Grid>
      </Grid>
    </Border>
  </DataTemplate>
  <Style x:Key="InlinePowerStyle" TargetType="ToggleSwitch">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="28" />
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="ManipulationMode" Value="System,TranslateX" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleSwitch">
      <Grid x:Name="SwitchAreaGrid" Width="48" Height="28" Background="Transparent">
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal" />
            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="SwitchAreaGrid.Opacity" Value="0.85" /></VisualState.Setters></VisualState>
            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="SwitchAreaGrid.Opacity" Value="0.7" /></VisualState.Setters></VisualState>
            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="SwitchAreaGrid.Opacity" Value="0.35" /></VisualState.Setters></VisualState>
          </VisualStateGroup>
          <VisualStateGroup x:Name="ToggleStates">
            <VisualState x:Name="Off" />
            <VisualState x:Name="On"><VisualState.Setters>
              <Setter Target="SwitchKnobBounds.Fill" Value="{StaticResource AppAccentBrush}" />
              <Setter Target="SwitchKnobBounds.StrokeThickness" Value="0" />
              <Setter Target="KnobTranslateTransform.X" Value="20" />
              <Setter Target="Knob.Fill" Value="{StaticResource AppOnAccentBrush}" />
            </VisualState.Setters></VisualState>
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Rectangle x:Name="SwitchKnobBounds" RadiusX="14" RadiusY="14" StrokeThickness="1.5" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" Fill="{ThemeResource ControlAltFillColorSecondaryBrush}" />
        <Grid x:Name="SwitchKnob" Width="20" Height="20" Margin="4,0,0,0" HorizontalAlignment="Left">
          <Grid.RenderTransform><TranslateTransform x:Name="KnobTranslateTransform" /></Grid.RenderTransform>
          <Ellipse x:Name="Knob" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <Thumb x:Name="SwitchThumb" AutomationProperties.AccessibilityView="Raw">
          <Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent" /></ControlTemplate></Thumb.Template>
        </Thumb>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
