<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="using:MiHouse.App.Views">
  <views:BooleanVisibilityConverter x:Key="BooleanVisibilityConverter" />
  <views:HasTextConverter x:Key="HasTextConverter" />
  <views:QrImageConverter x:Key="QrImageConverter" />
  <views:OnlineOpacityConverter x:Key="OnlineOpacityConverter" />
  <SolidColorBrush x:Key="MonogramTintBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
  <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style x:Key="PropertySurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
</ResourceDictionary>
