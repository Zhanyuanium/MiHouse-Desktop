<UserControl x:Class="MiHouse.App.Views.SettingsCard" x:Name="Root"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border x:Name="RootCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16">
    <Grid ColumnSpacing="16" MinHeight="40">
      <!-- The text column absorbs the free space and shrinks first, so a long description never
           pushes the trailing control under the text; the trailing column keeps its own width. -->
      <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <FontIcon Glyph="{Binding Glyph, ElementName=Root}" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="{Binding Header, ElementName=Root}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Description, ElementName=Root}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Description, ElementName=Root}" />
      </StackPanel>
      <ContentPresenter Grid.Column="2" Content="{Binding Trailing, ElementName=Root}" VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>
  </Border>
</UserControl>
