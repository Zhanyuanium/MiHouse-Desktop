<Page
  x:Class="MiHouse.App.Views.DevicesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:spec="using:MiHouse.Core.Spec"
  Background="{ThemeResource LayerFillColorDefaultBrush}"
  Loaded="OnLoaded" Unloaded="OnUnloaded" SizeChanged="OnSizeChanged" KeyDown="OnKeyDown">
  <Page.Resources>
    <CollectionViewSource x:Key="GroupedDevices" IsSourceGrouped="True" />
  </Page.Resources>
  <Grid RowSpacing="16" Padding="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock Text="我的设备" Style="{ThemeResource TitleTextBlockStyle}" />
        <TextBlock Text="{Binding AccountLabel}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Command="{Binding RefreshCommand}" AutomationProperties.Name="刷新设备列表" ToolTipService.ToolTip="刷新设备列表">
          <FontIcon Glyph="&#xE72C;" FontSize="16" />
        </Button>
        <Button Content="退出登录" Command="{Binding SignOutCommand}" Style="{StaticResource QuietButtonStyle}"
          AutomationProperties.Name="退出小米账号" />
      </StackPanel>
    </Grid>
    <InfoBar Grid.Row="1" IsOpen="{Binding Error, Converter={StaticResource HasTextConverter}}"
      Severity="Error" IsClosable="False" Title="无法加载设备" Message="{Binding Error}" AutomationProperties.LiveSetting="Polite">
      <InfoBar.ActionButton>
        <Button Content="重试" Command="{Binding RefreshCommand}" AutomationProperties.Name="重新加载设备列表" />
      </InfoBar.ActionButton>
    </InfoBar>
    <Grid Grid.Row="2">
      <SplitView x:Name="DetailsSplitView" PanePlacement="Right" DisplayMode="Inline" OpenPaneLength="360"
        IsPaneOpen="{Binding HasSelection, Mode=OneWay}" IsTabStop="False"
        PaneOpened="OnPaneOpened" PaneClosed="OnPaneClosed"
        PaneBackground="{ThemeResource LayerFillColorDefaultBrush}">
        <SplitView.Pane>
          <Grid Padding="16,0,0,0" RowSpacing="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding SelectedDevice.Name}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedDevice.Model}" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
              <Button x:Name="CloseDetailsButton" Grid.Column="1" Command="{Binding CloseDetailsCommand}" Click="OnCloseDetails" VerticalAlignment="Top"
                Style="{StaticResource QuietButtonStyle}" AutomationProperties.Name="关闭设备详情" ToolTipService.ToolTip="关闭详情">
                <FontIcon Glyph="&#xE711;" FontSize="16" />
              </Button>
            </Grid>
            <StackPanel Grid.Row="1" Spacing="8">
              <InfoBar IsOpen="{Binding DetailError, Converter={StaticResource HasTextConverter}}" Severity="Error"
                IsClosable="False" Title="无法加载属性" Message="{Binding DetailError}" AutomationProperties.LiveSetting="Polite">
                <InfoBar.ActionButton>
                  <Button Content="重试" Command="{Binding ReloadPropertiesCommand}" AutomationProperties.Name="重新加载设备属性" />
                </InfoBar.ActionButton>
              </InfoBar>
              <ProgressBar IsIndeterminate="True" Visibility="{Binding IsDetailBusy, Converter={StaticResource BooleanVisibilityConverter}}"
                AutomationProperties.Name="正在读取设备属性" />
              <TextBlock Text="{Binding DetailMessage}" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Properties}" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource PropertySurfaceStyle}">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ServiceName}" Style="{ThemeResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4"
                          HorizontalAlignment="Left" Visibility="{Binding HasValue, Converter={StaticResource BooleanVisibilityConverter}, ConverterParameter=Inverse}">
                          <TextBlock Text="本地/云端" Style="{ThemeResource CaptionTextBlockStyle}" ToolTipService.ToolTip="当前值不可用；未判断连接方式" />
                        </Border>
                        <TextBlock Text="{Binding TextValue}" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.Name="当前属性值" />
                        <ToggleSwitch IsOn="{Binding BoolValue, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                          OnContent="开启" OffContent="关闭" AutomationProperties.Name="{Binding Name}"
                          Visibility="{Binding IsBoolean, Converter={StaticResource BooleanVisibilityConverter}}" />
                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                          PlaceholderText="选择值" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Name}"
                          Visibility="{Binding IsChoice, Converter={StaticResource BooleanVisibilityConverter}}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="spec:SpecValueList">
                              <TextBlock Text="{x:Bind Description}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Spacing="4" Visibility="{Binding IsRange, Converter={StaticResource BooleanVisibilityConverter}}">
                          <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" StepFrequency="{Binding Step}"
                            TickFrequency="{Binding Step}" SnapsTo="StepValues" Value="{Binding NumericValue, Mode=TwoWay}"
                            IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Name}" />
                          <TextBlock Text="{Binding NumericText}" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <Button Content="应用" Command="{Binding ApplyCommand}" AutomationProperties.Name="{Binding ApplyLabel}"
                          Visibility="{Binding IsEditable, Converter={StaticResource BooleanVisibilityConverter}}" />
                        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibilityConverter}}"
                          AutomationProperties.Name="正在写入属性" />
                        <InfoBar IsOpen="{Binding Error, Converter={StaticResource HasTextConverter}}" IsClosable="False"
                          Severity="Error" Message="{Binding Error}" AutomationProperties.LiveSetting="Polite" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </SplitView.Pane>
        <Grid>
          <ListView x:Name="DeviceList" ItemsSource="{Binding Source={StaticResource GroupedDevices}}"
            SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" SelectionMode="Single" HorizontalContentAlignment="Stretch"
            AutomationProperties.Name="按房间分组的设备">
            <ListView.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" Margin="12,16,0,8" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="8,12" ColumnSpacing="16" AutomationProperties.Name="{Binding AccessibleName}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="40" Height="40" Background="{ThemeResource MonogramTintBrush}" CornerRadius="8">
                    <TextBlock Text="{Binding Monogram}" Style="{ThemeResource SubtitleTextBlockStyle}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{Binding Model}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Style="{ThemeResource CaptionTextBlockStyle}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}"
                      Opacity="{Binding IsOnline, Converter={StaticResource OnlineOpacityConverter}}" />
                    <TextBlock Text="{Binding OnlineLabel}" Style="{ThemeResource CaptionTextBlockStyle}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360"
            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibilityConverter}}">
            <TextBlock Text="还没有设备" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="请先在米家 App 中添加设备，再刷新此列表。" Style="{StaticResource SecondaryTextStyle}"
              TextAlignment="Center" />
          </StackPanel>
          <ProgressRing Width="40" Height="40" IsActive="{Binding IsBusy}" VerticalAlignment="Top" Margin="0,24,0,0"
            Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibilityConverter}}" AutomationProperties.Name="正在加载设备" />
        </Grid>
      </SplitView>
    </Grid>
  </Grid>
</Page>
