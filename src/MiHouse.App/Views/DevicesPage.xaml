<Page x:Class="MiHouse.App.Views.DevicesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:MiHouse.App.Views"
 Background="Transparent" Loaded="OnLoaded" Unloaded="OnUnloaded" SizeChanged="OnSizeChanged" KeyDown="OnKeyDown">
 <Page.Resources>
  <DataTemplate x:Key="PropertyTemplate"><views:PropertyEditor /></DataTemplate>
  <DataTemplate x:Key="ActionTemplate"><views:ActionGroup /></DataTemplate>
  <DataTemplate x:Key="SectionTemplate"><StackPanel Margin="0,8,0,4">
   <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Visibility="{Binding IsAdvanced, Converter={StaticResource BooleanVisibilityConverter}, ConverterParameter=Inverse}" />
   <Button Content="{Binding Name}" Command="{Binding Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Visibility="{Binding IsAdvanced, Converter={StaticResource BooleanVisibilityConverter}}" />
  </StackPanel></DataTemplate>
  <views:DetailTemplateSelector x:Key="DetailTemplates" PropertyTemplate="{StaticResource PropertyTemplate}" ActionTemplate="{StaticResource ActionTemplate}" HeaderTemplate="{StaticResource SectionTemplate}" />
   <x:Double x:Key="PaneToggleButtonHeight">36</x:Double>
   <Style x:Key="RoomTabItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
    <Setter Property="MinHeight" Value="0" /><Setter Property="Height" Value="{StaticResource PaneToggleButtonHeight}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
   </Style>
 </Page.Resources>
 <NavigationView x:Name="ShellNavigation" PaneDisplayMode="Auto" OpenPaneLength="208" CompactPaneLength="56" ExpandedModeThresholdWidth="1200" CompactModeThresholdWidth="700"
   IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" AlwaysShowHeader="False" IsTitleBarAutoPaddingEnabled="False"
   ItemInvoked="OnNavigationInvoked" PaneOpening="OnNavigationPaneOpening" PaneClosing="OnNavigationPaneClosing" PaneOpened="OnNavigationPaneChanged" PaneClosed="OnNavigationPaneChanged">
  <NavigationView.MenuItems>
    <NavigationViewItem x:Name="NativeHome" Content="首页" Tag="Home" Icon="Home" Loaded="OnNavigationItemLoaded" />
   <NavigationViewItem x:Name="NativeScenes" Content="场景" Tag="Scenes" Icon="Play" />
   <NavigationViewItem x:Name="NativeActivity" Content="活动" Tag="Activity" Icon="Clock" />
   <NavigationViewItem x:Name="NativeSettings" Content="设置" Tag="Settings" Icon="Setting" />
   <NavigationViewItemSeparator x:Name="RoomSeparator" />
   <NavigationViewItem x:Name="NativeRooms" Content="房间" SelectsOnInvoked="False" IsExpanded="True" />
  </NavigationView.MenuItems>
    <Grid x:Name="NavigationContent" Background="{ThemeResource LayerFillColorDefaultBrush}"><Grid.RowDefinitions><RowDefinition x:Name="NavigationRow" Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
       <Grid x:Name="RoomStrip" Margin="16,0,16,0" Height="{StaticResource PaneToggleButtonHeight}" SizeChanged="OnRoomStripSizeChanged">
     <Grid.Transitions><TransitionCollection /></Grid.Transitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
      <Button x:Name="PreviousRooms" Width="24" Height="{StaticResource PaneToggleButtonHeight}" MinWidth="0" Padding="0" VerticalContentAlignment="Center" Style="{StaticResource QuietButtonStyle}" Click="OnPreviousRooms" AutomationProperties.Name="向左滚动房间"><FontIcon Glyph="&#xE76B;" FontSize="12" /></Button>
    <ScrollViewer x:Name="RoomScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" HorizontalContentAlignment="Left" ViewChanged="OnRoomScrollChanged" SizeChanged="OnRoomScrollSizeChanged" Loaded="OnRoomScrollLoaded" AutomationProperties.Name="所有房间，一次点击切换">
         <ListView x:Name="RoomChips" SelectionMode="Single" SelectionChanged="OnRoomSelectionChanged" Height="{StaticResource PaneToggleButtonHeight}" Padding="0" BorderThickness="0"
          ItemContainerStyle="{StaticResource RoomTabItemStyle}"
         ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
         <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
        <ListView.Resources><x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean></ListView.Resources>
        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
        <ListView.ItemTemplate><DataTemplate><Grid Height="{StaticResource PaneToggleButtonHeight}" Loaded="OnRoomChipLoaded">
          <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Width="20" Height="3" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
            Background="{ThemeResource ListViewItemSelectionIndicatorBrush}" IsHitTestVisible="False"
            Visibility="{Binding IsActive, Converter={StaticResource BooleanVisibilityConverter}}" />
        </Grid></DataTemplate></ListView.ItemTemplate>
      </ListView>
    </ScrollViewer>
    <Border x:Name="RoomLeftFade" Grid.Column="1" Width="12" HorizontalAlignment="Left" IsHitTestVisible="False" Background="{ThemeResource RoomEdgeBrush}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleX="-1" /></Border.RenderTransform></Border>
    <Border x:Name="RoomRightFade" Grid.Column="1" Width="12" HorizontalAlignment="Right" IsHitTestVisible="False" Background="{ThemeResource RoomEdgeBrush}" />
      <Button x:Name="NextRooms" Grid.Column="2" Width="24" Height="{StaticResource PaneToggleButtonHeight}" MinWidth="0" Padding="0" VerticalContentAlignment="Center" Style="{StaticResource QuietButtonStyle}" Click="OnNextRooms" AutomationProperties.Name="向右滚动房间"><FontIcon Glyph="&#xE76C;" FontSize="12" /></Button>
   </Grid>
   <StackPanel Grid.Row="1" Margin="24,0" Spacing="8">
    <InfoBar Visibility="{Binding Error, Converter={StaticResource HasTextConverter}}" IsOpen="{Binding Error, Converter={StaticResource HasTextConverter}}" IsClosable="False" Severity="Error" Title="操作未完成" Message="{Binding Error}" />
   </StackPanel>
   <Grid x:Name="DetailsHost" Grid.Row="2" SizeChanged="OnDetailsHostSizeChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <Frame x:Name="ScreenFrame" Background="Transparent"><Frame.ContentTransitions><TransitionCollection /></Frame.ContentTransitions></Frame>
    <Border x:Name="SheetScrim" Grid.ColumnSpan="2" Background="{ThemeResource SmokeFillColorDefaultBrush}" Visibility="Collapsed" Tapped="OnSheetScrimTapped" />
    <Border x:Name="DeviceSheet" Grid.ColumnSpan="2" Width="420" HorizontalAlignment="Right" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="{Binding HasSelection, Converter={StaticResource BooleanVisibilityConverter}}" AutomationProperties.Name="设备详情">
     <Grid Padding="16,12,0,0" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid ColumnSpacing="12" Margin="0,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource MonogramTintBrush}" VerticalAlignment="Top"><PathIcon Width="20" Height="20" Data="{Binding SelectedDevice.CategoryKey, Converter={StaticResource DeviceIconConverter}}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
       <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding SelectedDevice.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" /><TextBlock Text="{Binding SelectedDevice.RoomStatusText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
       <Button x:Name="CloseDetailsButton" Grid.Column="2" Command="{Binding CloseDetailsCommand}" Click="OnCloseDetails" VerticalAlignment="Top" Style="{StaticResource QuietButtonStyle}" AutomationProperties.Name="关闭设备详情"><FontIcon Glyph="&#xE711;" FontSize="16" /></Button>
      </Grid>
      <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,16,0" Visibility="{Binding HasDetailStatus, Converter={StaticResource BooleanVisibilityConverter}}">
       <InfoBar IsOpen="{Binding DetailError, Converter={StaticResource HasTextConverter}}" Visibility="{Binding DetailError, Converter={StaticResource HasTextConverter}}" Severity="Error" IsClosable="False" Message="{Binding DetailError}" />
       <TextBlock Text="{Binding DetailStaleMessage}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
         Visibility="{Binding DetailStaleMessage, Converter={StaticResource HasTextConverter}}" AutomationProperties.LiveSetting="Polite" />
       <ProgressBar IsIndeterminate="True" Visibility="{Binding IsDetailBusy, Converter={StaticResource BooleanVisibilityConverter}}" AutomationProperties.Name="正在读取设备属性" />
       <TextBlock Text="{Binding DetailMessage}" TextWrapping="Wrap" Visibility="{Binding DetailMessage, Converter={StaticResource HasTextConverter}}" />
      </StackPanel>
      <ListView x:Name="DetailList" Grid.Row="2" ItemsSource="{Binding DetailRows}" ItemTemplateSelector="{StaticResource DetailTemplates}" SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch" Padding="0,0,24,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="设备属性与操作">
       <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /></Style></ListView.ItemContainerStyle>
      </ListView>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </NavigationView>
</Page>
