<UserControl x:Class="MiHouse.App.Views.PropertyEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appearance="using:MiHouse.App.Appearance"
 xmlns:spec="using:MiHouse.Core.Spec">
 <StackPanel>
  <TextBlock Text="{Binding ServiceName}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{StaticResource AppAccentBrush}" Visibility="{Binding IsSectionStart, Converter={StaticResource BooleanVisibilityConverter}}" />
  <Border Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"><StackPanel Spacing="6">
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
    <ToggleSwitch Grid.Column="1" Style="{StaticResource InlinePowerStyle}" IsOn="{Binding BoolValue, Mode=OneWay}" Toggled="OnToggle" IsEnabled="{Binding CanEdit}" Visibility="{Binding IsEditableBoolean, Converter={StaticResource BooleanVisibilityConverter}}" AutomationProperties.Name="{Binding Name}" Loaded="OnEditorLoaded" Unloaded="OnEditorUnloaded" DataContextChanged="OnEditorContextChanged" />
   </Grid>
   <TextBlock Text="{Binding TextValue}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" MaxLines="3" TextTrimming="CharacterEllipsis" Visibility="{Binding DisplayCurrentValue, Converter={StaticResource BooleanVisibilityConverter}}" />
   <Button Content="查看完整值" Style="{StaticResource QuietButtonStyle}" FontSize="12" Padding="0,4" Visibility="{Binding HasLongValue, Converter={StaticResource BooleanVisibilityConverter}}">
    <Button.Flyout><Flyout><ScrollViewer Width="280" MaxHeight="240" HorizontalScrollBarVisibility="Disabled"><TextBlock Text="{Binding TextValue}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></ScrollViewer></Flyout></Button.Flyout>
   </Button>
   <TextBlock Text="值不可用" FontSize="12" Style="{StaticResource SecondaryTextStyle}" Visibility="{Binding HasValue, Converter={StaticResource BooleanVisibilityConverter}, ConverterParameter=Inverse}" />
   <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=OneWay}" SelectionChanged="OnChoice" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" Visibility="{Binding IsEditableChoice, Converter={StaticResource BooleanVisibilityConverter}}" AutomationProperties.Name="{Binding Name}" Loaded="OnEditorLoaded" Unloaded="OnEditorUnloaded" DataContextChanged="OnEditorContextChanged">
    <ComboBox.ItemTemplate><DataTemplate x:DataType="spec:SpecValueList"><TextBlock Text="{x:Bind Description}" /></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
   <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" StepFrequency="{Binding SliderStepFrequency}" SnapsTo="StepValues" Value="{Binding NumericValue, Mode=OneWay}" ValueChanged="OnRange" KeyUp="OnRangeKeyUp" LostFocus="OnRangeLostFocus" IsEnabled="{Binding CanEdit}" Visibility="{Binding IsEditableRange, Converter={StaticResource BooleanVisibilityConverter}}" AutomationProperties.Name="{Binding Name}" Loaded="OnEditorLoaded" Unloaded="OnEditorUnloaded" DataContextChanged="OnEditorContextChanged" />
   <TextBox Text="{Binding EditorText, Mode=OneWay}" TextChanged="OnTextChanged" LostFocus="OnTextCommit" KeyDown="OnTextKeyDown" IsEnabled="{Binding CanEdit}" Visibility="{Binding IsCommitText, Converter={StaticResource BooleanVisibilityConverter}}" AutomationProperties.Name="{Binding Name}" Loaded="OnEditorLoaded" Unloaded="OnEditorUnloaded" DataContextChanged="OnEditorContextChanged" />
   <ProgressBar appearance:MotionGate.Indeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibilityConverter}}" />
   <InfoBar Severity="Error" IsClosable="False" IsOpen="{Binding Error, Converter={StaticResource HasTextConverter}}" Visibility="{Binding Error, Converter={StaticResource HasTextConverter}}" Message="{Binding Error}" />
  </StackPanel></Border>
 </StackPanel>
</UserControl>
