<Page x:Class="MiHouse.App.Views.RoomPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="using:MiHouse.App.Views">
  <views:PageLayout x:Name="Layout" Heading="{Binding PageTitle}" Subtitle="{Binding SelectedHome.Name}"
    Loaded="OnPageLoaded" Unloaded="OnPageUnloaded" DataContextChanged="OnContextChanged" SizeChanged="OnTilesSizeChanged">
    <views:PageLayout.HeaderContent>
      <StackPanel AutomationProperties.LiveSetting="Polite">
        <TextBlock Text="房间加载失败，请重试。" Style="{StaticResource SecondaryTextStyle}" Margin="0,24,0,0"
          Visibility="{Binding IsRoomFailed, Converter={StaticResource BooleanVisibilityConverter}}" />
        <TextBlock Text="这个房间暂无可显示的设备" Style="{StaticResource SecondaryTextStyle}" Margin="0,24,0,0"
          Visibility="{Binding IsRoomEmpty, Converter={StaticResource BooleanVisibilityConverter}}" />
        <InfoBar Severity="Warning" Message="刷新失败，保留已有数据" IsClosable="False" Margin="0,12,0,0"
          IsOpen="{Binding HasRefreshFailure}" AutomationProperties.LiveSetting="Polite"
          Visibility="{Binding HasRefreshFailure, Converter={StaticResource BooleanVisibilityConverter}}" />
      </StackPanel>
    </views:PageLayout.HeaderContent>
    <views:PageLayout.ItemTemplate><DataTemplate>
      <ItemsControl ItemsSource="{Binding Devices}" HorizontalContentAlignment="Stretch" Margin="{Binding BottomSpacing}">
        <ItemsControl.ItemContainerTransitions><TransitionCollection /></ItemsControl.ItemContainerTransitions>
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:ResponsiveGridPanel MinimumItemWidth="1" MaximumColumns="{Binding Columns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><views:DeviceTile DeviceOpened="OnDeviceOpened" /></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate></views:PageLayout.ItemTemplate>
  </views:PageLayout>
</Page>
