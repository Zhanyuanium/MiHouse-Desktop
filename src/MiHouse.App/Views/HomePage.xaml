<Page x:Class="MiHouse.App.Views.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:MiHouse.App.Views">
  <views:PageLayout Heading="首页" Subtitle="{Binding SelectedHome.Name}">
   <views:PageLayout.Body><StackPanel Spacing="24">
   <Border Style="{StaticResource SectionSurfaceStyle}"><StackPanel Spacing="16">
    <Grid><TextBlock Text="家中环境" FontWeight="SemiBold" /><TextBlock Text="刷新时读取" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
    <TextBlock Text="无数据" FontSize="28" Visibility="{Binding HasSensorReadings, Converter={StaticResource BooleanVisibilityConverter}, ConverterParameter=Inverse}" />
    <ItemsControl ItemsSource="{Binding MetricGroups}" HorizontalContentAlignment="Stretch">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:ResponsiveGridPanel MinimumItemWidth="230" MaximumColumns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="12">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
      <ItemsControl ItemsSource="{Binding Readings}" HorizontalContentAlignment="Stretch">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:ResponsiveGridPanel MinimumItemWidth="180" MaximumColumns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel Spacing="3" Margin="0,0,0,8"><TextBlock Text="{Binding MetricValueText}" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SourceLabel}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" /></StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel></Border>
   <views:ResponsiveGridPanel MaximumColumns="2" MinimumItemWidth="340">
     <Border Style="{StaticResource SectionSurfaceStyle}" Padding="0" Height="392">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
       <Grid Height="32" Margin="16,16,16,0"><TextBlock Text="场景" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="查看全部" Command="{Binding NavigateScenesCommand}" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Right" IsEnabled="{Binding HasSelectedHome}" /></Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="场景卡片">
        <Border Padding="16"><StackPanel DataContext="{Binding ScenePanel}" Spacing="8">
        <TextBlock Text="还没有手动场景" Style="{StaticResource SecondaryTextStyle}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibilityConverter}}" />
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Visibility="{Binding Notice, Converter={StaticResource HasTextConverter}}" />
        <InfoBar Severity="Error" Message="{Binding Error}" IsOpen="{Binding Error, Converter={StaticResource HasTextConverter}}" Visibility="{Binding Error, Converter={StaticResource HasTextConverter}}" />
        <ItemsControl ItemsSource="{Binding Scenes}" HorizontalContentAlignment="Stretch"
          ItemTemplate="{StaticResource SceneCardTemplate}" ItemsPanel="{StaticResource DashboardCardsPanel}" />
        </StackPanel></Border>
      </ScrollViewer>
     </Grid>
    </Border>
     <Border Style="{StaticResource SectionSurfaceStyle}" Padding="0" Height="392">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Height="32" Margin="16,16,16,0"><TextBlock Text="快捷开关" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Text="按类别控制" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="设备分类卡片">
        <Border Padding="16"><ItemsControl ItemsSource="{Binding DeviceClasses}" HorizontalContentAlignment="Stretch" ItemsPanel="{StaticResource DashboardCardsPanel}">
         <ItemsControl.ItemTemplate><DataTemplate><Button DataContext="{Binding Card}" Style="{StaticResource SectionTileButtonStyle}" Click="OnGroupCardClick" AutomationProperties.Name="{Binding Name}">
          <Grid><views:FeedbackHalo Level="{Binding HaloLevel}" />
          <Grid ColumnSpacing="8" RowSpacing="8" VerticalAlignment="Center" Padding="{StaticResource DashboardCardPadding}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
          <views:GroupPowerSwitch Grid.Column="1" State="{Binding PowerState}" IsEnabled="{Binding CanToggle}" PowerRequested="OnGroupPowerRequested" AutomationProperties.Name="{Binding Name}" Visibility="{Binding HasPower, Converter={StaticResource BooleanVisibilityConverter}}" />
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Summary}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Notice}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding Notice, Converter={StaticResource HasTextConverter}}" AutomationProperties.LiveSetting="Polite" />
          </Grid></Grid>
        </Button></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl></Border>
      </ScrollViewer>
     </Grid>
    </Border>
   </views:ResponsiveGridPanel>
   <Border Style="{StaticResource SectionSurfaceStyle}"><StackPanel Spacing="12"><TextBlock Text="收藏" FontWeight="SemiBold" /><StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,16"><FontIcon Glyph="&#xE734;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><TextBlock Text="让常用设备触手可及" FontWeight="SemiBold" /><TextBlock Text="设备固定与排序功能尚未开放" FontSize="12" Style="{StaticResource SecondaryTextStyle}" /></StackPanel></StackPanel></Border>
   </StackPanel></views:PageLayout.Body>
  </views:PageLayout>
</Page>
