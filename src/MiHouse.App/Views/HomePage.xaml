<Page x:Class="MiHouse.App.Views.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appearance="using:MiHouse.App.Appearance"
 xmlns:views="using:MiHouse.App.Views">
  <Page.Resources>
    <ItemsPanelTemplate x:Key="EnvironmentMetricColumns"><views:ResponsiveGridPanel MinimumItemWidth="230" MaximumColumns="3" /></ItemsPanelTemplate>
    <Style x:Key="EnvironmentMetricGroup" TargetType="StackPanel">
      <Setter Property="Spacing" Value="12" />
      <Setter Property="MinHeight" Value="168" />
    </Style>
  </Page.Resources>
  <views:PageLayout Heading="首页" Subtitle="{Binding SelectedHome.Name}">
   <views:PageLayout.Body><StackPanel Spacing="24">
   <Border Style="{StaticResource SectionSurfaceStyle}"><StackPanel Spacing="16">
    <Grid><TextBlock Text="家中环境" FontWeight="SemiBold" /><TextBlock Text="刷新时读取" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
     <Grid>
     <TextBlock Text="无数据" FontSize="28" Visibility="{Binding HasNoSensorReadings, Converter={StaticResource BooleanVisibilityConverter}}" />
     <ItemsControl HorizontalContentAlignment="Stretch" ItemsPanel="{StaticResource EnvironmentMetricColumns}"
       Visibility="{Binding AreReadingsLoading, Converter={StaticResource BooleanVisibilityConverter}}">
      <ItemsControl.Items><x:String>温度</x:String><x:String>湿度</x:String><x:String>空气质量</x:String></ItemsControl.Items>
      <ItemsControl.ItemTemplate><DataTemplate><StackPanel Style="{StaticResource EnvironmentMetricGroup}">
       <TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" />
       <StackPanel Spacing="3" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="36">
         <ProgressRing Width="16" Height="16" MinWidth="16" MinHeight="16" appearance:MotionGate.Active="True" VerticalAlignment="Center" AutomationProperties.Name="正在读取环境数据" />
         <TextBlock Text="读取中" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <Border Height="16" />
       </StackPanel>
      </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <ItemsControl ItemsSource="{Binding MetricGroups}" HorizontalContentAlignment="Stretch" ItemsPanel="{StaticResource EnvironmentMetricColumns}"
       Visibility="{Binding HasSensorReadings, Converter={StaticResource BooleanVisibilityConverter}}">
      <ItemsControl.ItemTemplate><DataTemplate><StackPanel Style="{StaticResource EnvironmentMetricGroup}">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" />
      <ItemsControl ItemsSource="{Binding Readings}" HorizontalContentAlignment="Stretch">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:ResponsiveGridPanel MinimumItemWidth="180" MaximumColumns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel Spacing="3" Margin="0,0,0,8"><TextBlock Text="{Binding MetricValueText}" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SourceLabel}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" /></StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     </Grid>
   </StackPanel></Border>
   <views:ResponsiveGridPanel MaximumColumns="2" MinimumItemWidth="340">
      <Border x:Name="ScenesSection" Style="{StaticResource SectionSurfaceStyle}" Padding="0" Height="416">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Height="32" Margin="16,16,16,0"><TextBlock Text="场景" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="查看全部" Click="OnScenesOpened" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Right" IsEnabled="{Binding HasSelectedHome}" /></Grid>
       <Border Grid.Row="1" Padding="16"><ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="场景卡片">
         <StackPanel DataContext="{Binding ScenePanel}" Spacing="8">
        <TextBlock Text="还没有手动场景" Style="{StaticResource SecondaryTextStyle}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibilityConverter}}" />
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Visibility="{Binding Notice, Converter={StaticResource HasTextConverter}}" />
        <InfoBar Severity="Error" Message="{Binding Error}" IsOpen="{Binding Error, Converter={StaticResource HasTextConverter}}" Visibility="{Binding Error, Converter={StaticResource HasTextConverter}}" />
        <ItemsControl ItemsSource="{Binding Scenes}" HorizontalContentAlignment="Stretch"
          ItemTemplate="{StaticResource SceneCardTemplate}" ItemsPanel="{StaticResource DashboardCardsPanel}" />
         </StackPanel>
       </ScrollViewer></Border>
     </Grid>
    </Border>
      <Border x:Name="DeviceClassesSection" Style="{StaticResource SectionSurfaceStyle}" Padding="0" Height="416">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
       <Grid Height="32" Margin="16,16,16,0"><TextBlock Text="设备类别" FontWeight="SemiBold" VerticalAlignment="Center" /></Grid>
       <Border Grid.Row="1" Padding="16"><ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="设备类别卡片">
         <ItemsControl ItemsSource="{Binding DeviceClasses}" HorizontalContentAlignment="Stretch" ItemsPanel="{StaticResource DashboardCardsPanel}">
         <ItemsControl.ItemContainerTransitions><TransitionCollection /></ItemsControl.ItemContainerTransitions>
         <ItemsControl.ItemTemplate><DataTemplate><Button DataContext="{Binding Card}" Style="{StaticResource SectionTileButtonStyle}" Click="OnGroupCardClick" AutomationProperties.Name="{Binding Name}">
          <Grid><views:FeedbackHalo Level="{Binding HaloLevel}" />
           <Grid ColumnSpacing="12" RowSpacing="8" VerticalAlignment="Center" Padding="{StaticResource DashboardCardPadding}"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Grid.RowSpan="3" Width="40" Height="40" CornerRadius="12" Background="{StaticResource DeviceIconBackdropBrush}" VerticalAlignment="Center"><PathIcon Width="20" Height="20" Data="{Binding IconKey, Converter={StaticResource DeviceIconConverter}}" Foreground="{StaticResource DeviceIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
            <views:GroupPowerSwitch Grid.Column="2" State="{Binding PowerState}" IsEnabled="{Binding CanToggle}" PowerRequested="OnGroupPowerRequested" AutomationProperties.Name="{Binding Name}" Visibility="{Binding HasPower, Converter={StaticResource BooleanVisibilityConverter}}" />
            <TextBlock Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Summary}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Notice}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding Notice, Converter={StaticResource HasTextConverter}}" AutomationProperties.LiveSetting="Polite" />
          </Grid></Grid>
        </Button></DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
       </ScrollViewer></Border>
     </Grid>
    </Border>
   </views:ResponsiveGridPanel>
   <Border Style="{StaticResource SectionSurfaceStyle}"><StackPanel Spacing="12"><TextBlock Text="收藏" FontWeight="SemiBold" /><StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,16"><FontIcon Glyph="&#xE734;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><TextBlock Text="让常用设备触手可及" FontWeight="SemiBold" /><TextBlock Text="设备固定与排序功能尚未开放" FontSize="12" Style="{StaticResource SecondaryTextStyle}" /></StackPanel></StackPanel></Border>
   </StackPanel></views:PageLayout.Body>
  </views:PageLayout>
</Page>
