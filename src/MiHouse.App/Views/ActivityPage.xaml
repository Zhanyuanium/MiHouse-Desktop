<Page x:Class="MiHouse.App.Views.ActivityPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:MiHouse.App.Views">
  <views:PageLayout Heading="活动" Subtitle="{Binding SelectedHome.Name}">
    <views:PageLayout.Body>
      <Border Style="{StaticResource SectionSurfaceStyle}">
        <StackPanel Spacing="16">
          <TextBlock Text="活动记录 · 未实现" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="本机操作" IsEnabled="False" AutomationProperties.Name="本机操作筛选，未实现" />
            <Button Content="读取时观察到" IsEnabled="False" AutomationProperties.Name="读取变化筛选，未实现" />
          </StackPanel>
          <TextBlock Text="尚未提供持久操作记录，不生成示例历史。" Style="{StaticResource SecondaryTextStyle}" />
          <TextBlock Text="后续将区分已确认、未确认与未知结果。其他成员的操作追踪需要新的事件来源。" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
      </Border>
    </views:PageLayout.Body>
  </views:PageLayout>
</Page>
