<Page x:Class="MiHouse.App.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:MiHouse.App.Views">
  <Page.Resources>
    <Style x:Key="PlannedTag" TargetType="TextBlock">
      <Setter Property="Text" Value="未实现" /><Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style x:Key="AccentSwatchButtonStyle" TargetType="Button">
      <Setter Property="Padding" Value="0" /><Setter Property="MinWidth" Value="0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="SwatchSurface" Width="28" Height="28" CornerRadius="8"
          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}" />
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Page.Resources>
  <views:PageLayout Heading="设置" Subtitle="账号、家庭与使用偏好">
    <views:PageLayout.Body>
      <StackPanel Spacing="24">
        <StackPanel Spacing="10">
          <TextBlock Text="账号与家庭" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="4,0,0,2" />
          <views:SettingsCard Header="当前账号" Description="{Binding AccountLabel}" Glyph="&#xE77B;">
            <views:SettingsCard.Trailing><Button Content="退出登录" Command="{Binding SignOutCommand}" AutomationProperties.Name="退出小米账号并清除本机会话" /></views:SettingsCard.Trailing>
          </views:SettingsCard>
          <TextBlock Text="退出将清除本机保存的登录会话。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,0,0,4" />
          <views:SettingsCard Header="账号管理" Description="管理账号信息与登录方式" Glyph="&#xE8D4;">
            <views:SettingsCard.Trailing><TextBlock Style="{StaticResource PlannedTag}" /></views:SettingsCard.Trailing>
          </views:SettingsCard>
          <views:SettingsCard Header="家庭成员" Description="查看家庭成员与共享权限" Glyph="&#xE716;">
            <views:SettingsCard.Trailing><TextBlock Style="{StaticResource PlannedTag}" /></views:SettingsCard.Trailing>
          </views:SettingsCard>
        </StackPanel>
        <StackPanel Spacing="10">
          <TextBlock Text="外观" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="4,0,0,2" />
          <views:SettingsCard Header="深浅模式" Description="跟随系统、浅色或深色" Glyph="&#xE708;">
            <views:SettingsCard.Trailing>
              <RadioButtons x:Name="ThemeModeSelector" MaxColumns="3" SelectionChanged="OnThemeModeChanged">
                <x:String>跟随系统</x:String><x:String>浅色</x:String><x:String>深色</x:String>
              </RadioButtons>
            </views:SettingsCard.Trailing>
          </views:SettingsCard>
          <views:SettingsCard Header="主题色" Description="应用内彩色控件与设备图标使用的强调色" Glyph="&#xE790;">
            <views:SettingsCard.Trailing>
              <StackPanel x:Name="AccentControls" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <RadioButtons x:Name="AccentSourceSelector" MaxColumns="2" SelectionChanged="OnAccentSourceChanged">
                  <x:String>系统强调色</x:String><x:String>自定义</x:String>
                </RadioButtons>
                <Button x:Name="AccentSwatchButton" Style="{StaticResource AccentSwatchButtonStyle}" Background="{StaticResource AppAccentBrush}"
                  BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                  AutomationProperties.Name="自定义主题色" ToolTipService.ToolTip="选择自定义主题色">
                  <Button.Flyout>
                    <Flyout>
                      <ColorPicker x:Name="AccentPicker" IsAlphaEnabled="False" IsColorChannelTextInputVisible="False"
                        IsHexInputVisible="True" ColorSpectrumShape="Ring" ColorChanged="OnAccentColorChanged" />
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </views:SettingsCard.Trailing>
          </views:SettingsCard>
          <views:SettingsCard Header="彩色图标" Description="设备图标使用主题色，关闭后转为中性色" Glyph="&#xE7C6;">
            <views:SettingsCard.Trailing>
              <ToggleSwitch IsOn="{Binding Appearance.UseColoredIcons, Mode=TwoWay}" OnContent="彩色" OffContent="中性"
                AutomationProperties.Name="设备图标使用主题色" />
            </views:SettingsCard.Trailing>
          </views:SettingsCard>
          <views:SettingsCard Header="动效" Description="关闭后停止自绘动效与加载动画，保留静态状态提示" Glyph="&#xE768;">
            <views:SettingsCard.Trailing>
              <ToggleSwitch IsOn="{Binding Appearance.AnimationsEnabled, Mode=TwoWay}" OnContent="开" OffContent="关"
                AutomationProperties.Name="启用动效" />
            </views:SettingsCard.Trailing>
          </views:SettingsCard>
        </StackPanel>
        <StackPanel Spacing="10">
          <TextBlock Text="体验与偏好" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="4,0,0,2" />
          <views:SettingsCard Header="通知" Description="管理本机操作结果与提醒" Glyph="&#xE7F4;">
            <views:SettingsCard.Trailing><TextBlock Style="{StaticResource PlannedTag}" /></views:SettingsCard.Trailing>
          </views:SettingsCard>
          <views:SettingsCard Header="耗材" Description="设备耗材与剩余寿命" Glyph="&#xE9D9;">
            <views:SettingsCard.Trailing><TextBlock Style="{StaticResource PlannedTag}" /></views:SettingsCard.Trailing>
          </views:SettingsCard>
        </StackPanel>
        <StackPanel Spacing="10">
          <TextBlock Text="应用信息" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="4,0,0,2" />
          <views:SettingsCard x:Name="AboutCard" Header="关于 MiHouse" Description="版本信息、许可与开源声明" Glyph="&#xE946;">
            <views:SettingsCard.Trailing><TextBlock Style="{StaticResource PlannedTag}" /></views:SettingsCard.Trailing>
          </views:SettingsCard>
        </StackPanel>
      </StackPanel>
    </views:PageLayout.Body>
  </views:PageLayout>
</Page>
