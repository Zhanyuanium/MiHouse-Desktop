<UserControl x:Class="MiHouse.App.Views.DeviceTile" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appearance="using:MiHouse.App.Appearance"
  xmlns:views="using:MiHouse.App.Views" Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDeviceChanged"
  VerticalAlignment="Top">
  <Grid>
    <Border x:Name="Surface" Style="{StaticResource SectionSurfaceStyle}" Padding="0" MinHeight="96"
      Tapped="OnSurfaceTapped" PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
      <Grid>
        <views:FeedbackHalo x:Name="ActiveHalo" />
        <Border x:Name="HoverOverlay" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" IsHitTestVisible="False" />
        <Grid ColumnSpacing="12" Padding="12" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Button x:Name="OpenButton" Click="OnOpen" Style="{StaticResource FlatHitButtonStyle}" Padding="0" MinWidth="0"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"
            AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="打开设备详情">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid Style="{StaticResource DeviceIconAreaStyle}">
                <Viewbox Style="{StaticResource DeviceIconViewboxStyle}">
                  <PathIcon Style="{StaticResource DeviceIconPathStyle}" Data="{Binding CategoryKey, Converter={StaticResource DeviceIconConverter}}"
                    Foreground="{StaticResource DeviceIconBrush}" />
                </Viewbox>
              </Grid>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                <TextBlock x:Name="RoomLine" Text="{Binding RoomStatusText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel x:Name="StateLine" MinHeight="16">
                  <ProgressRing Width="12" Height="12" HorizontalAlignment="Left"
                    appearance:MotionGate.Active="{Binding ShowsReadingPlaceholder}"
                    Visibility="{Binding ShowsReadingPlaceholder, Converter={StaticResource BooleanVisibilityConverter}}"
                    AutomationProperties.Name="正在读取设备状态" />
                  <Grid Visibility="{Binding Power.IsWriteUnconfirmed, Converter={StaticResource BooleanVisibilityConverter}, ConverterParameter=Inverse, FallbackValue=Visible}">
                  <TextBlock Text="{Binding TileStateText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{Binding TileStateText, Converter={StaticResource HasTextConverter}}"
                     TextWrapping="Wrap" ToolTipService.ToolTip="{Binding TileStateText}" AutomationProperties.LiveSetting="Polite" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Button>
          <ToggleSwitch x:Name="PowerSwitch" Grid.Column="1" IsOn="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
            Visibility="{Binding HasPower, Converter={StaticResource BooleanVisibilityConverter}}"
            Style="{StaticResource InlinePowerStyle}" VerticalAlignment="Center" HorizontalAlignment="Right"
            AutomationProperties.Name="{Binding PowerAccessibleName}" AutomationProperties.HelpText="{Binding PowerHelpText}" ToolTipService.ToolTip="{Binding PowerHelpText}" />
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TileError}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
            Visibility="{Binding HasTileError, Converter={StaticResource BooleanVisibilityConverter}}"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
